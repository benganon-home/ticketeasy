# Firebase web config (safe to expose — protection is via Firestore rules).
# Copy to .env.local and fill from the Firebase console (Project settings).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Set to "true" to point the app at the local emulator suite.
VITE_USE_EMULATORS=false

# --- Server-side keys (Vercel env vars — NOT VITE_ prefixed, never bundled) ---
# firebase-admin service account, base64-encoded JSON (for api/ functions):
#   base64 -i ~/Downloads/ticketeasy-cc50c-firebase-adminsdk-*.json
FIREBASE_SERVICE_ACCOUNT=
# Anthropic API key for ticket OCR (api/ticket-ocr.js):
ANTHROPIC_API_KEY=
# Optional: override the OCR model (default claude-opus-4-8; e.g. claude-haiku-4-5 for cost)
OCR_MODEL=
# Google Maps Platform key for venue lookup (server; api/venue-lookup.js + seed):
GOOGLE_MAPS_SERVER_KEY=

# --- Client key (bundled — restrict by HTTP referrer in Google Cloud) ---
# Google Maps static-map/embed key for the event page:
VITE_GOOGLE_MAPS_BROWSER_KEY=
